# OceanEmbed Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# ──────────────────────────────────────────────
# Copernicus Marine Service (CMEMS)
# Required for: GLORYS12V1, OSTIA SST, DUACS SLA, SSS, surface winds
# Register at: https://marine.copernicus.eu/
# ──────────────────────────────────────────────
COPERNICUSMARINE_SERVICE_USERNAME=your_cmems_username
COPERNICUSMARINE_SERVICE_PASSWORD=your_cmems_password

# ──────────────────────────────────────────────
# INCOIS ERDDAP (ARGO Indian Ocean)
# Base URL for INCOIS ERDDAP server
# Public: no credentials typically needed
# ──────────────────────────────────────────────
INCOIS_ERDDAP_BASE_URL=https://erddap.incois.gov.in/erddap

# ──────────────────────────────────────────────
# Argo GDAC (Global ARGO data via FTP/HTTP)
# Public: no credentials needed
# ──────────────────────────────────────────────
ARGO_GDAC_FTP=ftp://ftp.ifremer.fr/ifremer/argo
ARGO_GDAC_HTTP=https://data-argo.ifremer.fr

# ──────────────────────────────────────────────
# ESA CCI SST (optional, for experiments)
# ──────────────────────────────────────────────
ESA_CCI_SST_URL=https://surfacetemperature.org

# ──────────────────────────────────────────────
# Application settings
# ──────────────────────────────────────────────
OCEANEMBED_DATA_ROOT=./data
OCEANEMBED_ARTIFACTS_ROOT=./artifacts
OCEANEMBED_LOG_LEVEL=INFO
OCEANEMBED_DEMO_MODE=true
OCEANEMBED_RANDOM_SEED=42

# ──────────────────────────────────────────────
# Backend
# ──────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
